# Copy this file to C:\ProgramData\LawDesk\config\lawdesk.env.
# Replace every DEGISTIRIN/example value before installation.

# Native Windows listener: IIS is the only public entry point.
# Required only on Windows 10 after IT verifies ESU or a supported LTSC lifecycle.
WINDOWS_10_SUPPORT_VERIFIED=false
NODE_ENV=production
PORT=3001
BACKEND_BIND_ADDRESS=127.0.0.1
APP_BASE_URL=https://lawdesk.example.gov.tr
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=1

# PostgreSQL 16 on this computer or an institution-managed PostgreSQL host.
# Keep DATABASE_URL empty so inherited workstation settings cannot override DB_*.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gys_lawdesk
DB_USER=lawdesk_app
DB_PASSWORD=DEGISTIRIN
DB_SSL_MODE=disable
DB_SSL_CA_PATH=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
POSTGRES_BIN=C:\Program Files\PostgreSQL\16\bin

# Persistent application data. Keep this outside the Git repository.
ATTACHMENT_STORAGE_DIR=C:\ProgramData\LawDesk\attachments

# Session and request security.
AUTH_TOKEN_SECRET=DEGISTIRIN
AUTH_TOKEN_TTL_HOURS=8
AUTH_COOKIE_NAME=lawdesk_session
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_WINDOW_MINUTES=15
REGISTRATION_RATE_LIMIT_MAX=5
ACTIVATION_TOKEN_TTL_HOURS=24

# Institution SMTP.
SMTP_JSON_TRANSPORT=false
SMTP_HOST=smtp.example.gov.tr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_USER=lawdesk@example.gov.tr
SMTP_PASSWORD=DEGISTIRIN
SMTP_FROM=LawDesk <lawdesk@example.gov.tr>
EMAIL_OUTBOX_POLL_INTERVAL_MS=30000
EMAIL_OUTBOX_RETRY_BASE_MS=60000
EMAIL_OUTBOX_MAX_ATTEMPTS=10
EMAIL_OUTBOX_LOCK_TIMEOUT_MS=300000
EMAIL_OUTBOX_BATCH_SIZE=10

# Used once. Remove INITIAL_ADMIN_PASSWORD after successful creation.
INITIAL_ADMIN_NAME=Ilk Admin
INITIAL_ADMIN_EMAIL=admin@example.gov.tr
INITIAL_ADMIN_EMAIL_VERIFIED=false
INITIAL_ADMIN_PASSWORD=DEGISTIRIN
