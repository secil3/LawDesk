# Bu dosyayi deploy/production.env olarak kopyalayin. Gercek sirlar Git'e eklenmez.

# Dis erisim (varsayilan: yalnizca ayni sunucudaki reverse proxy)
LAWDESK_BIND_ADDRESS=127.0.0.1
LAWDESK_HTTP_PORT=8080

# PostgreSQL
# Birlikte verilen PostgreSQL icin DB_HOST=postgres kullanin.
# Kurum PostgreSQL'i icin hostu degistirin ve DB_SSL_MODE=verify-full yapin.
DB_HOST=postgres
DB_PORT=5432
POSTGRES_DB=gys_lawdesk
POSTGRES_USER=lawdesk_app
POSTGRES_PASSWORD=DEGISTIRIN
DB_SSL_MODE=disable
DB_SSL_CA_PATH=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Uygulama ve oturum
NODE_ENV=production
PORT=3001
APP_BASE_URL=https://lawdesk.example.gov.tr
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=2
AUTH_TOKEN_SECRET=DEGISTIRIN
AUTH_TOKEN_TTL_HOURS=8
AUTH_COOKIE_NAME=lawdesk_session

# Istek sinirlari
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_WINDOW_MINUTES=15
REGISTRATION_RATE_LIMIT_MAX=5
ACTIVATION_TOKEN_TTL_HOURS=24

# Kurumsal SMTP
SMTP_JSON_TRANSPORT=false
SMTP_HOST=smtp.example.gov.tr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_USER=lawdesk@example.gov.tr
SMTP_PASSWORD=DEGISTIRIN
SMTP_FROM=LawDesk <lawdesk@example.gov.tr>

# Yalnizca ilk admin olusturulurken doldurulur; sonra parola dosyadan silinir.
INITIAL_ADMIN_NAME=Ilk Admin
INITIAL_ADMIN_EMAIL=admin@example.gov.tr
INITIAL_ADMIN_EMAIL_VERIFIED=false
INITIAL_ADMIN_PASSWORD=DEGISTIRIN
